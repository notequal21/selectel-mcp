# ── Обязательные: сервисный пользователь Selectel ────────────────────────────
# Номер аккаунта (в правом верхнем углу панели my.selectel.ru)
SELECTEL_ACCOUNT_ID=123456
# Имя сервисного пользователя (Управление доступом → Сервисные пользователи)
SELECTEL_USERNAME=mcp-agent
# Пароль: задайте ОДИН из вариантов
SELECTEL_PASSWORD=
# SELECTEL_PASSWORD_FILE=~/.config/selectel-mcp/password      # файл с правами 600
# SELECTEL_PASSWORD_CMD=security find-generic-password -w -s selectel-mcp   # macOS Keychain
# SELECTEL_PASSWORD_CMD=pass show selectel/mcp                              # pass / gopass

# ── Проект и регион по умолчанию ─────────────────────────────────────────────
SELECTEL_PROJECT_ID=
SELECTEL_REGION=ru-9

# ── Безопасность ─────────────────────────────────────────────────────────────
# readonly (по умолчанию) | safe (создание/изменение, без удаления) | full (всё)
SELECTEL_MCP_MODE=readonly
# auto (по умолчанию: диалог в клиенте, если поддерживается, иначе план + confirm_token) | elicit | token | none
SELECTEL_CONFIRM=auto
# Ограничения (через запятую; id или имена)
# SELECTEL_ALLOWED_PROJECTS=my-project
# SELECTEL_ALLOWED_REGIONS=ru-9,ru-7
# Серверы, которые нельзя удалить/пересоздать (имена или id). Ещё можно повесить metadata protected=true
# SELECTEL_PROTECTED_SERVERS=prod-db,prod-web
# SELECTEL_MAX_SERVERS_PER_CALL=3
# Отключить отдельные инструменты (поддерживается суффикс *)
# SELECTEL_DISABLED_TOOLS=server_console_url,s3_presign_*
# Журнал действий (по умолчанию ~/.selectel-mcp/audit.jsonl; off — выключить)
# SELECTEL_AUDIT_LOG=~/.selectel-mcp/audit.jsonl
# Каталог, в пределах которого разрешено читать/писать локальные файлы (загрузка в S3/скачивание)
# SELECTEL_FILES_ROOT=~/selectel-files

# ── S3 (необязательно) ───────────────────────────────────────────────────────
# S3-ключ сервисного пользователя
# SELECTEL_S3_ACCESS_KEY=
# SELECTEL_S3_SECRET_KEY=
# SELECTEL_S3_POOL=ru-1
